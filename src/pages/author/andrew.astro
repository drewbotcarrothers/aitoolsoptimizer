---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { url } from '../../data/url';
import { SITE } from '../../data/categories';
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const site = Astro.site!;
const pageUrl = new URL(url('/author/andrew/'), site).href;
const ld = {
  '@context': 'https://schema.org', '@type': 'ProfilePage', url: pageUrl,
  mainEntity: {
    '@type': 'Person', name: 'Andrew', url: pageUrl,
    description: 'DIY tech enthusiast and optimizer based in Toronto, Canada, with over 19 years of corporate experience.',
    homeLocation: { '@type': 'Place', name: 'Toronto, Canada' },
    sameAs: ['https://www.youtube.com/@aitoolsoptimizer'],
    worksFor: { '@type': 'Organization', name: SITE.name, url: new URL(url('/'), site).href },
  },
};
---
<Base title="Andrew, author" description="About Andrew, who runs AI Tools Optimizer: a DIY tech enthusiast and optimizer in Toronto with over 19 years of corporate experience.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <section class="container section prose">
    <span class="pill">// author</span><h1><span class="grad">Andrew</span></h1>
    <p>Andrew is a DIY tech enthusiast and optimizer based in Toronto, Canada. With over 19 years of corporate experience at a leading Canadian company, Andrew combines deep industry knowledge with a passion for technology to help people understand AI and choose AI tools that fit their work and budget.</p>
    <h2>What Andrew publishes here</h2>
    <ul class="check">
      <li>The <a href={url('/tools/')}>AI tools directory</a>: plans, prices, free tiers and features checked against each company's official pages.</li>
      <li>The <a href={url('/models/')}>AI model comparison</a>: release dates, context windows and API prices.</li>
      <li><a href={url('/ai-news/')}>Daily AI news roundups</a> and the <a href={url('/blog/')}>guides and comparisons</a> on the blog.</li>
      <li>Video versions on the <a href="https://www.youtube.com/@aitoolsoptimizer" rel="noopener noreferrer" target="_blank">AI Tools Optimizer YouTube channel</a>.</li>
    </ul>
    <p>How articles are researched, dated and corrected is explained in <a href={url('/methodology/')}>how we research and update content</a>. AI Tools Optimizer is independent and is not affiliated with the companies it covers; see <a href={url('/about/')}>About</a> and the <a href={url('/disclaimer/')}>Disclaimer</a>.</p>
    <h2>Contact</h2>
    <p>Corrections, questions and outdated prices: <a href="mailto:contact@aitoolsoptimizer.com">contact@aitoolsoptimizer.com</a>.</p>
  </section>
  <section class="container section">
    <div class="section-head"><h2>Latest from Andrew</h2><a href={url('/blog/')}>All posts →</a></div>
    <div class="grid">{posts.slice(0, 6).map((p) => <PostCard post={p} />)}</div>
  </section>
</Base>
