---
import data from '../../data/models.json';

type Model = (typeof data.models)[number];
const models: Model[] = data.models;
const dash = '—';
// Same formatting as /models/. A missing price stays an em dash; nothing is filled in.
const money = (n: number | null) => n == null ? dash : `$${n % 1 === 0 ? n : n.toFixed(2).replace(/0$/, '')}`;
const updated = data.lastUpdated
  ? new Date(data.lastUpdated + 'T12:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })
  : dash;
const source = 'https://aitoolsoptimizer.com/models/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>AI model pricing tracker</title>
  <meta name="description" content="Frontier AI model API prices in USD per million tokens." />
  <meta name="robots" content="noindex" />
  <meta name="theme-color" content="#070A13" />
  <style>
    :root {
      --bg: #070A13;
      --surface: #0E1324;
      --surface-2: #151B33;
      --border: #232B4D;
      --text: #E6ECFF;
      --muted: #8A94B8;
      --cyan: #00E5FF;
    }
    * { box-sizing: border-box; }
    html, body { height: 100%; }
    body {
      margin: 0;
      display: flex;
      flex-direction: column;
      background: var(--bg);
      color: var(--text);
      font: 14px/1.4 system-ui, -apple-system, "Segoe UI", sans-serif;
    }
    header, footer { flex: none; padding: .65rem .85rem; }
    header { border-bottom: 1px solid var(--border); background: var(--surface); }
    .title { margin: 0; font-size: .95rem; font-weight: 700; letter-spacing: .01em; }
    .updated { margin: .15rem 0 0; color: var(--muted); font-size: .75rem; }
    .table-scroll { flex: 1; overflow: auto; }
    table { width: 100%; border-collapse: collapse; min-width: 460px; font-size: .8rem; }
    caption {
      caption-side: bottom;
      padding: .45rem .85rem .15rem;
      text-align: left;
      color: var(--muted);
      font-size: .7rem;
    }
    th, td { padding: .4rem .7rem; text-align: left; border-bottom: 1px solid var(--border); vertical-align: top; }
    th {
      position: sticky;
      top: 0;
      background: var(--surface-2);
      color: var(--muted);
      font-size: .68rem;
      font-weight: 600;
      letter-spacing: .04em;
      text-transform: uppercase;
      white-space: nowrap;
    }
    td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    tbody tr:hover { background: rgba(0, 229, 255, .05); }
    footer {
      border-top: 1px solid var(--border);
      background: var(--surface);
      font-size: .75rem;
      color: var(--muted);
    }
    footer p { margin: 0; }
    a { color: var(--cyan); }
    footer a { text-underline-offset: 2px; }
  </style>
</head>
<body>
  <header>
    <p class="title">AI model pricing tracker</p>
    <p class="updated">Last updated <time datetime={data.lastUpdated}>{updated}</time> · USD per 1M tokens</p>
  </header>
  <div class="table-scroll">
    <table>
      <caption>List prices from the same data as the models page. A dash means that price is not in the data.</caption>
      <thead>
        <tr>
          <th scope="col">Model</th>
          <th scope="col">Provider</th>
          <th class="num" scope="col">Input $/1M tokens</th>
          <th class="num" scope="col">Output $/1M tokens</th>
        </tr>
      </thead>
      <tbody>
        {models.map((m) => (
          <tr>
            <td>{m.model}</td>
            <td>{m.lab}</td>
            <td class="num">{money(m.priceIn)}</td>
            <td class="num">{money(m.priceOut)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <footer>
    <p>Source: <a href={source} target="_blank" rel="noopener">AI Tools Optimizer</a></p>
  </footer>
</body>
</html>
