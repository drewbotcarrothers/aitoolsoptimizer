---
import Base from '../layouts/Base.astro';
import EbookPromo from '../components/EbookPromo.astro';
import Newsletter from '../components/Newsletter.astro';
---
<Base title="Ebooks" description="Practical AI ebooks from AI Tools Optimizer.">
  <section class="container section">
    <span class="pill">// ebooks</span><h1>AI <span class="grad">Ebooks</span></h1>
    <p class="muted">Deep-dive guides you can keep. (Sample products — checkout not connected in this demo.)</p>
    <EbookPromo />
    <div class="grid" style="margin-top:2rem">
      <div class="card"><span class="sample-badge">COMING SOON</span><h3>Prompt Engineering for Beginners</h3><p class="muted">From vague requests to reliable results in one weekend.</p></div>
      <div class="card"><span class="sample-badge">COMING SOON</span><h3>Automate Your Business with AI</h3><p class="muted">No-code workflows that save 10+ hours a week.</p></div>
    </div>
  </section>
  <section class="container"><Newsletter /></section>
</Base>
