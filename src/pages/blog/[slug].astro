---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import { getCollection, render } from 'astro:content';
import { categories } from '../../data/categories';
import { url } from '../../data/url';
export async function getStaticPaths() { return (await getCollection('blog', (p) => !p.data.draft)).map((p) => ({ params: { slug: p.id }, props: { post: p } })); }
const { post } = Astro.props; const d = post.data;
const { Content } = await render(post);
const tools = (await getCollection('tools')).filter((t) => d.relatedTools.includes(t.id));
---
<Base title={d.title} description={d.description}>
  <article class="container section">
    <a href={url('/blog/')}>← Blog</a>
    <header class="ph">
      {d.category && <a class="pill" href={url(`/tools/category/${d.category}/`)}>{categories[d.category].name}</a>}
      <h1>{d.title}</h1>
      <p class="muted">By Andrew · {d.pubDate.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' })}</p>
    </header>
    <div class="prose"><Content /></div>
    <p class="notice prose">Disclosure: this post may contain affiliate links. If you buy through them we may earn a commission at no extra cost to you.</p>
    {tools.length > 0 && <section class="section"><h2>Tools mentioned in this post</h2><div class="grid">{tools.map((t) => <ToolCard tool={t} />)}</div></section>}
  </article>
</Base>
<style>.ph { margin: 1.5rem 0; max-width: 820px; } .ph .pill { margin-right: .5rem; }</style>
<script is:inline>
  const mermaidNodes = document.querySelectorAll('pre.mermaid');
  if (mermaidNodes.length) {
    const loader = document.createElement('script');
    loader.type = 'module';
    loader.textContent = `
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11.12.0/dist/mermaid.esm.min.mjs';
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: 'dark',
        themeVariables: {
          darkMode: true,
          background: '#0E1324',
          primaryColor: '#151B33',
          primaryTextColor: '#E6ECFF',
          primaryBorderColor: '#00E5FF',
          lineColor: '#8A94B8',
          secondaryColor: '#151B33',
          tertiaryColor: '#070A13',
          fontFamily: 'Inter, system-ui, sans-serif'
        }
      });
      await mermaid.run({ nodes: document.querySelectorAll('pre.mermaid') });
    `;
    document.body.appendChild(loader);
  }
</script>
