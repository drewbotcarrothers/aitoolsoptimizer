---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import EbookPromo from '../../components/EbookPromo.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getCollection, render } from 'astro:content';
import { categories } from '../../data/categories';
import { url } from '../../data/url';
export async function getStaticPaths() { return (await getCollection('blog')).map((p) => ({ params: { slug: p.id }, props: { post: p } })); }
const { post } = Astro.props; const d = post.data;
const { Content } = await render(post);
const tools = (await getCollection('tools')).filter((t) => d.relatedTools.includes(t.id));
---
<Base title={d.title} description={d.description}>
  <article class="container section">
    <a href={url('/blog/')}>← Blog</a>
    <header class="ph">
      {d.category && <a class="pill" href={url(`/tools/category/${d.category}/`)}>{categories[d.category].name}</a>}
      {d.sample && <span class="sample-badge">SAMPLE ARTICLE</span>}
      <h1>{d.title}</h1>
      <p class="muted">By Andrew · {d.pubDate.toLocaleDateString('en-CA', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' })}</p>
    </header>
    {d.sample && <p class="notice prose">This is placeholder demo content written to preview the site design. Facts should be verified before publishing.</p>}
    <AdSlot />
    <div class="prose"><Content /></div>
    <p class="notice prose">Disclosure: this post may contain affiliate links. If you buy through them we may earn a commission at no extra cost to you.</p>
    {tools.length > 0 && <section class="section"><h2>Tools mentioned in this post</h2><div class="grid">{tools.map((t) => <ToolCard tool={t} />)}</div></section>}
    <EbookPromo />
    <div style="margin-top:2rem"><Newsletter /></div>
  </article>
</Base>
<style>.ph { margin: 1.5rem 0; max-width: 820px; } .ph .pill { margin-right: .5rem; }</style>
