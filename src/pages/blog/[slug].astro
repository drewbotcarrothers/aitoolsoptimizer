---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import { getCollection, render } from 'astro:content';
import { categories } from '../../data/categories';
import { url } from '../../data/url';
import { blogFeaturedImage } from '../../lib/featuredImage';
import { postModified } from '../../lib/gitDates';
import { SITE } from '../../data/categories';
export async function getStaticPaths() { return (await getCollection('blog', (p) => !p.data.draft)).map((p) => ({ params: { slug: p.id }, props: { post: p } })); }
const { post } = Astro.props; const d = post.data;
const { Content } = await render(post);
const tools = (await getCollection('tools')).filter((t) => d.relatedTools.includes(t.id));
const image = blogFeaturedImage(post.id, d.featuredImage);
const modified = postModified(post.id, d.pubDate);
const fmt = (x: Date, tz: string) => x.toLocaleDateString('en-US', { timeZone: tz, year: 'numeric', month: 'long', day: 'numeric' });
const published = fmt(d.pubDate, 'UTC');
const updated = fmt(modified, 'America/Toronto');
const showUpdated = updated !== published && modified > d.pubDate;
const site = Astro.site!;
const pageUrl = new URL(url(`/blog/${post.id}/`), site).href;
const authorUrl = new URL(url('/author/andrew/'), site).href;
const ld = {
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  headline: d.title, description: d.description, url: pageUrl, mainEntityOfPage: pageUrl,
  ...(image ? { image: new URL(url(image), site).href } : {}),
  datePublished: d.pubDate.toISOString(), dateModified: modified.toISOString(),
  author: { '@type': 'Person', name: SITE.author, url: authorUrl },
  publisher: { '@type': 'Organization', name: SITE.name, url: new URL(url('/'), site).href, logo: { '@type': 'ImageObject', url: new URL(url('/logo-mark.png'), site).href } },
};
---
<Base title={d.title} description={d.description} image={image}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <article class="container section">
    <div class="post-col">
      <a href={url('/blog/')}>← Blog</a>
      <header class="ph">
        {d.category && <a class="pill" href={url(`/tools/category/${d.category}/`)}>{categories[d.category].name}</a>}
        <h1>{d.title}</h1>
        <p class="muted">By <a href={url('/author/andrew/')} rel="author">Andrew</a> · <time datetime={d.pubDate.toISOString()}>{published}</time>{showUpdated && <> · Updated <time datetime={modified.toISOString()}>{updated}</time></>} · <a href={url('/methodology/')}>How we research</a></p>
      </header>
      {image && <img class="hero" src={url(image)} alt="" width="1280" height="720" decoding="async" fetchpriority="high" />}
      <div class="prose"><Content /></div>
      <p class="notice prose">Disclosure: this post may contain affiliate links. If you buy through them we may earn a commission at no extra cost to you.</p>
    </div>
    {tools.length > 0 && <section class="section"><h2>Tools mentioned in this post</h2><div class="grid">{tools.map((t) => <ToolCard tool={t} />)}</div></section>}
  </article>
</Base>
<style>
  /* .section's shorthand padding clears .container's side padding. Put it back on the post page. */
  article.section { padding-left: 1.25rem; padding-right: 1.25rem; }
  /* Center the reading column in the wider container. Body copy stays left-aligned. */
  .post-col { max-width: 760px; margin-inline: auto; text-align: left; }
  .ph { margin: 1.5rem 0; }
  .hero { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--color-border); margin: 0 0 1.75rem; background: var(--color-surface); }
  .ph .pill { margin-right: .5rem; }
</style>
<script is:inline>
  const mermaidNodes = document.querySelectorAll('pre.mermaid');
  if (mermaidNodes.length) {
    const loader = document.createElement('script');
    loader.type = 'module';
    loader.textContent = `
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11.12.0/dist/mermaid.esm.min.mjs';
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: 'dark',
        themeVariables: {
          darkMode: true,
          background: '#0E1324',
          primaryColor: '#151B33',
          primaryTextColor: '#E6ECFF',
          primaryBorderColor: '#00E5FF',
          lineColor: '#8A94B8',
          secondaryColor: '#151B33',
          tertiaryColor: '#070A13',
          fontFamily: 'Inter, system-ui, sans-serif'
        }
      });
      await mermaid.run({ nodes: document.querySelectorAll('pre.mermaid') });
    `;
    document.body.appendChild(loader);
  }
</script>
