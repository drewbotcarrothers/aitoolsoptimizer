---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { url } from '../../data/url';
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base noindex={posts.length === 0} title="Blog" description="Guides, comparisons and tutorials about AI and AI tools.">
  <section class="container section">
    <span class="pill">// blog</span><h1>Guides &amp; <span class="grad">tutorials</span></h1>
    <p class="muted">Learn AI step by step — from your first prompt to building automated workflows.</p>
    {posts.length > 0 ? <div class="grid">{posts.map((p) => <PostCard post={p} />)}</div> : <p>The first guides are being written and will appear here once they are ready. In the meantime, browse the <a href={url('/tools/')}>AI tools directory</a> or the <a href={url('/models/')}>AI model comparison</a>.</p>}
  </section>
</Base>
