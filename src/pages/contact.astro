---
import Base from '../layouts/Base.astro';
---
<Base title="Contact" description="Contact AI Tools Optimizer by email at contact@aitoolsoptimizer.com with questions, corrections, tool suggestions or partnership enquiries.">
  <section class="container section prose">
    <span class="pill">// contact</span><h1>Get in <span class="grad">touch</span></h1>
    <p class="muted">Questions, corrections, tool suggestions or partnership enquiries are welcome. Andrew reads every message.</p>
    <p class="email-line">Email: <a href="mailto:contact@aitoolsoptimizer.com">contact@aitoolsoptimizer.com</a></p>
    <p>The form below opens a pre-filled message in your own email app. Nothing is sent until you press send there. If it doesn't open, email the address above directly.</p>
    <form id="contact-form" class="card form" method="post" action="mailto:contact@aitoolsoptimizer.com" enctype="text/plain">
      <label>Name<input name="name" required maxlength="100" autocomplete="name" /></label>
      <label>Topic<select name="topic"><option>General question</option><option>Correction</option><option>Suggest a tool</option><option>Partnership / affiliate</option><option>Advertising</option></select></label>
      <label>Message<textarea name="message" rows="6" required minlength="5" maxlength="5000"></textarea></label>
      <button class="btn" type="submit">Open in my email app</button>
    </form>
    <p class="muted small">How we handle your message is described in the <a href="../privacy/">Privacy Policy</a>.</p>
  </section>
</Base>
<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const body = `Name: ${fd.get('name')}\n\n${fd.get('message')}`;
    location.href = `mailto:contact@aitoolsoptimizer.com?subject=${encodeURIComponent('[AI Tools Optimizer] ' + String(fd.get('topic')))}&body=${encodeURIComponent(body)}`;
  });
</script>
<style>
  .form { display: grid; gap: 1rem; } label { display: grid; gap: .3rem; color: var(--color-muted); }
  .email-line { font-size: 1.15rem; } .small { font-size: .85rem; }
</style>
