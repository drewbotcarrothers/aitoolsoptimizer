---
import Base from '../layouts/Base.astro';
---
<Base title="Contact" description="Contact AI Tools Optimizer.">
  <section class="container section prose">
    <span class="pill">// contact</span><h1>Get in <span class="grad">touch</span></h1>
    <p class="muted">Questions, tool suggestions or partnership enquiries — send a message and Andrew will get back to you.</p>
    <form class="card form" onsubmit="event.preventDefault(); this.innerHTML='<p>✅ Thanks! (Demo form — nothing was sent.)</p>';">
      <label>Name<input name="name" required /></label>
      <label>Email<input type="email" name="email" required /></label>
      <label>Topic<select name="topic"><option>General question</option><option>Suggest a tool</option><option>Partnership / affiliate</option><option>Advertising</option></select></label>
      <label>Message<textarea name="message" rows="6" required></textarea></label>
      <button class="btn" type="submit">Send message</button>
    </form>
    <p class="notice">Demo: the form is not wired up yet. On Hostinger it can post to a small PHP mail handler like the sibling sites use.</p>
  </section>
</Base>
<style>.form { display: grid; gap: 1rem; } label { display: grid; gap: .3rem; color: var(--color-muted); }</style>
