---
import Base from '../layouts/Base.astro';
import { url } from '../data/url';
// PHP only runs on the production host (aitoolsoptimizer.com); preview builds use a mailto fallback.
const live = import.meta.env.BASE_URL === '/';
---
<Base title="Contact" description="Contact AI Tools Optimizer.">
  <section class="container section prose">
    <span class="pill">// contact</span><h1>Get in <span class="grad">touch</span></h1>
    <p class="muted">Questions, tool suggestions or partnership enquiries — send a message and Andrew will get back to you.</p>
    <p>Email: <a href="mailto:contact@aitoolsoptimizer.com">contact@aitoolsoptimizer.com</a></p>
    <form id="contact-form" class="card form" method="post" action={live ? url('/contact.php') : 'mailto:contact@aitoolsoptimizer.com'} data-live={live ? '1' : '0'}>
      <label>Name<input name="name" required maxlength="100" autocomplete="name" /></label>
      <label>Email<input type="email" name="email" required maxlength="254" autocomplete="email" /></label>
      <label>Topic<select name="topic"><option>General question</option><option>Suggest a tool</option><option>Partnership / affiliate</option><option>Advertising</option></select></label>
      <label>Message<textarea name="message" rows="6" required minlength="5" maxlength="5000"></textarea></label>
      <div class="hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
      <input type="hidden" name="ts" value="" />
      <button class="btn" type="submit">Send message</button>
      <p id="form-status" class="status" role="status" aria-live="polite" hidden></p>
    </form>
    {!live && <p class="notice">Preview site: the form opens your email app. On aitoolsoptimizer.com it sends directly.</p>}
  </section>
</Base>
<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status') as HTMLElement;
  (form.elements.namedItem('ts') as HTMLInputElement).value = String(Date.now());
  const show = (msg: string, ok: boolean) => { status.hidden = false; status.textContent = msg; status.className = 'status ' + (ok ? 'ok' : 'err'); };
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    if (form.dataset.live !== '1') {
      const body = `Name: ${fd.get('name')}\nEmail: ${fd.get('email')}\n\n${fd.get('message')}`;
      location.href = `mailto:contact@aitoolsoptimizer.com?subject=${encodeURIComponent(String(fd.get('topic')))}&body=${encodeURIComponent(body)}`;
      return;
    }
    const btn = form.querySelector('button') as HTMLButtonElement; btn.disabled = true; btn.textContent = 'Sending…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: fd, headers: { Accept: 'application/json', 'X-Requested-With': 'fetch' } });
      const data = await res.json();
      show(data.message, !!data.ok);
      if (data.ok) form.querySelectorAll('input:not([type=hidden]), textarea').forEach((el) => ((el as HTMLInputElement).value = ''));
    } catch {
      show('Sorry, something went wrong. Please email contact@aitoolsoptimizer.com directly.', false);
    } finally { btn.disabled = false; btn.textContent = 'Send message'; }
  });
</script>
<style>
  .form { display: grid; gap: 1rem; } label { display: grid; gap: .3rem; color: var(--color-muted); }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .status { margin: 0; padding: .7rem 1rem; border-radius: 10px; } .status.ok { border: 1px solid var(--color-lime); color: var(--color-lime); } .status.err { border: 1px solid var(--color-magenta); color: var(--color-magenta); }
</style>
