---
import '../styles/global.css';
import { SITE } from '../data/categories';
import { url } from '../data/url';
import { getCollection } from 'astro:content';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title, noindex = false, description = 'AI Tools Optimizer teaches you AI and helps you pick the right AI tools, with honest reviews, tips and a curated tools directory.' } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const hasPosts = (await getCollection('blog', (p) => !p.data.draft)).length > 0;
const nav = [['/tools/', 'Tools Directory'], ['/models/', 'Models'], ['/ai-news/', 'AI News'], ...(hasPosts ? [['/blog/', 'Blog']] : []), ['/about/', 'About'], ['/contact/', 'Contact']];
const sisterSites = [
  ['https://canadianoptimizer.com/', 'Canadian Optimizer'],
  ['https://canadiancreditcardfinder.com/', 'Canadian Credit Card Finder'],
  ['https://canadiandatainsights.com/', 'Canadian Data Insights'],
  ['https://latestmortgagerates.ca/', 'Latest Mortgage Rates'],
  ['https://makemoneyoptimizer.com/', 'Make Money Optimizer'],
  ['https://savingoptimizer.com/', 'Saving Optimizer'],
  ['https://stocksummarizer.com/', 'Stock Summarizer'],
];
const external = { rel: 'noopener noreferrer', target: '_blank' };
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/').replace(/\/404\/$/, '/404.html'), Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex" /> : <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /></>}
  <link rel="icon" href={url('/favicon.ico')} sizes="any" />
  <link rel="icon" href={url('/favicon-32.png')} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(url('/og-image.png'), Astro.site).href} />
  <meta name="twitter:card" content="summary" />
  <meta name="theme-color" content="#070A13" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800&family=Inter:wght@400;600&family=JetBrains+Mono&display=swap" rel="stylesheet" />
  {import.meta.env.BASE_URL === '/' && <Fragment>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-8QRK7THNC1" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-8QRK7THNC1');
  </script>
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7909541570116920" crossorigin="anonymous" is:inline></script>
  </Fragment>}
  <slot name="head" />
</head>
<body>
  <header class="site-header">
    <div class="container bar">
      <a href={url('/')} class="logo"><img class="mark" src={url('/logo-mark.png')} alt="" width="32" height="32" /> AI Tools <span class="grad">Optimizer</span></a>
      <nav class="desktop-nav">{nav.map(([href, label]) => <a href={url(href)}>{label}</a>)}</nav>
      <details class="mobile-nav">
        <summary aria-label="Menu">☰</summary>
        <nav>{nav.map(([href, label]) => <a href={url(href)}>{label}</a>)}</nav>
      </details>
    </div>
  </header>
  <main><slot /></main>
  <footer class="site-footer">
    <div class="container foot">
      <div>
        <a href={url('/')} class="logo"><img class="mark" src={url('/logo-mark.png')} alt="" width="32" height="32" /> AI Tools <span class="grad">Optimizer</span></a>
        <p class="muted">{SITE.tagline}<br />Made by Andrew.<br /><a href="mailto:contact@aitoolsoptimizer.com">contact@aitoolsoptimizer.com</a><br /><a href="https://www.youtube.com/@aitoolsoptimizer" {...external}>YouTube</a></p>
      </div>
      <div class="links">
        <a href={url('/tools/')}>Tools</a><a href={url('/models/')}>Models</a><a href={url('/ai-news/')}>AI News</a>{hasPosts && <a href={url('/blog/')}>Blog</a>}<a href={url('/about/')}>About</a>
        <a href={url('/contact/')}>Contact</a><a href={url('/privacy/')}>Privacy Policy</a><a href={url('/cookies/')}>Cookie Policy</a><a href={url('/terms/')}>Terms of Use</a><a href={url('/disclaimer/')}>Disclaimer</a>
      </div>
    </div>
    <div class="container more-sites">
      <p class="foot-label">Also by Andrew</p>
      <div class="links">
        {sisterSites.map(([href, label]) => <a href={href} {...external}>{label}</a>)}
      </div>
    </div>
    <div class="container muted small">Disclosure: some links may be affiliate links; we may earn a commission at no extra cost to you. See our <a href={url('/disclaimer/')}>Disclaimer</a>. © {new Date().getFullYear()} AI Tools Optimizer.</div>
  </footer>
</body>
</html>
<style>
  .site-header { position: sticky; top: 0; z-index: 10; backdrop-filter: blur(12px); background: rgba(7,10,19,.75); border-bottom: 1px solid var(--color-border); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 1rem; }
  .logo { font-family: var(--font-display); font-weight: 800; color: var(--color-text); font-size: 1.1rem; white-space: nowrap; }
  .mark { width: 1.9em; height: 1.9em; vertical-align: middle; margin-right: .3em; filter: drop-shadow(0 0 6px rgba(0,229,255,.35)); }
  .logo { display: inline-flex; align-items: center; gap: .25em; }
  nav { display: flex; gap: 1.25rem; flex-wrap: wrap; } nav a { color: var(--color-muted); font-size: .95rem; } nav a:hover { color: var(--color-text); }
  .site-footer { border-top: 1px solid var(--color-border); margin-top: 4rem; padding: 2.5rem 0 1.5rem; background: rgba(14,19,36,.6); }
  .foot { display: flex; justify-content: space-between; gap: 2rem; flex-wrap: wrap; } .links { display: flex; gap: .65rem 1.25rem; flex-wrap: wrap; align-items: center; }
  .more-sites { margin-top: 1.5rem; }
  .foot-label { margin: 0 0 .55rem; font-family: var(--font-display); font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--color-muted); }
  .small { font-size: .8rem; margin-top: 1.5rem; }
  .mobile-nav { display: none; position: relative; }
  .mobile-nav summary { list-style: none; cursor: pointer; font-size: 1.4rem; color: var(--color-cyan); padding: .2rem .6rem; border: 1px solid var(--color-border); border-radius: 10px; }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav[open] summary { border-color: var(--color-cyan); box-shadow: var(--glow-cyan); }
  .mobile-nav nav { position: absolute; right: 0; top: calc(100% + .5rem); flex-direction: column; gap: .25rem; min-width: 200px; padding: .75rem; background: var(--color-surface-2); border: 1px solid var(--color-border); border-radius: var(--radius); box-shadow: var(--glow-violet); }
  .mobile-nav nav a { padding: .45rem .6rem; border-radius: 8px; } .mobile-nav nav a:hover { background: rgba(0,229,255,.08); }
  @media (max-width: 760px) { .desktop-nav { display: none; } .mobile-nav { display: block; } }
</style>
