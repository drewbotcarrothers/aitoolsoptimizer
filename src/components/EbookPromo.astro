---
import { url } from '../data/url';
---
<section class="card ebook">
  <div class="cover"><span>THE<br/>AI TOOLS<br/>PLAYBOOK</span><small>2026 EDITION</small></div>
  <div>
    <span class="sample-badge">SAMPLE PRODUCT</span>
    <h2>The AI Tools Playbook</h2>
    <p class="muted">A practical guide to choosing, combining and getting real results from AI tools — 120+ pages of workflows, prompts and checklists.</p>
    <ul class="check"><li>50 copy-paste prompt templates</li><li>Tool stacks for creators, marketers and developers</li><li>Cost-saving tips for paid plans</li></ul>
    <a class="btn" href={url('/ebooks/')}>Get the ebook — $19</a>
  </div>
</section>
<style>
  .ebook { display: grid; grid-template-columns: 220px 1fr; gap: 2rem; align-items: center; padding: 2rem; }
  .cover { aspect-ratio: 3/4; border-radius: 10px; background: var(--gradient-brand); display: flex; flex-direction: column; justify-content: space-between; padding: 1.2rem; color: var(--color-bg); font-family: var(--font-display); font-weight: 800; font-size: 1.3rem; box-shadow: 0 20px 50px rgba(139,92,246,.45); transform: rotate(-3deg); }
  .cover small { font-size: .7rem; } h2 { margin: .5rem 0; }
  @media (max-width: 760px) { .ebook { grid-template-columns: 1fr; } .cover { max-width: 200px; } }
</style>
