{
  "$ref": "#/definitions/tools",
  "definitions": {
    "tools": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "audio-voice-music",
            "automation-agents",
            "chatbots-assistants",
            "coding",
            "customer-support",
            "data-analytics",
            "design",
            "education",
            "image-generation",
            "marketing-seo",
            "meetings-transcription",
            "presentations",
            "productivity-notes",
            "research-search",
            "sales",
            "video",
            "writing"
          ]
        },
        "tagline": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "pricing": {
          "type": "string",
          "enum": [
            "free",
            "freemium",
            "paid"
          ]
        },
        "website": {
          "type": "string",
          "format": "uri"
        },
        "affiliateUrl": {
          "type": "string",
          "format": "uri"
        },
        "rating": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "pros": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "cons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "tips": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "useCases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "company": {
          "type": "string"
        },
        "subcategory": {
          "type": "string"
        },
        "bestFor": {
          "type": "string"
        },
        "pricingModel": {
          "type": "string"
        },
        "startingPrice": {
          "type": "string"
        },
        "freePlan": {
          "type": "string"
        },
        "keyFeatures": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "sourceUrls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "default": []
        },
        "lastVerified": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "lastUpdated": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "sample": {
          "type": "boolean",
          "default": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "category",
        "tagline",
        "description",
        "pricing",
        "website",
        "lastUpdated"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}