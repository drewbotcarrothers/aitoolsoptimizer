        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "pubDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "audio-voice-music",
            "automation-agents",
            "chatbots-assistants",
            "coding",
            "customer-support",
            "data-analytics",
            "design",
            "education",
            "image-generation",
            "marketing-seo",
            "meetings-transcription",
            "presentations",
            "productivity-notes",
            "research-search",
            "sales",
            "video",
            "writing"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "relatedTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "sample": {
          "type": "boolean",
          "default": false
        },
        "draft": {
          "type": "boolean",
          "default": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
